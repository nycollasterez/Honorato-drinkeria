# ====================================================================
# HONORATO DRINKERIA - CONFIGURAÇÃO APACHE / HOSTGATOR (.htaccess)
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Manter arquivos e pastas existentes intactos (como /api/*.php, assets, imagens)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Redirecionar todas as rotas do frontend (/cardapio, /comandas, /caixa, etc.) para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão GZIP para carregamento ultra rápido em celulares
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# NUNCA fazer cache do index.html (garante que atualizações entrem na hora para todos os aparelhos)
<FilesMatch "\.(html|htm)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </IfModule>
</FilesMatch>

# Cache de arquivos estáticos versionados (CSS, JS com hash no nome)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Bloquear listagem de diretórios por segurança
Options -Indexes

# Cabeçalhos de Segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
